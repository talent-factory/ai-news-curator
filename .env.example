# TF LLM-Gateway (LiteLLM) — Zugang
# Provider-Keys liegen NICHT in dieser App, sondern als Fly-Secret am Gateway.

# Virtual Key des Gateways (sk-...), least privilege auf news-curator/classify.
# Erzeugen am Gateway: scripts/provision_keys.sh (KEY_ALIAS=news-curator ...)
GATEWAY_KEY=sk-REPLACE

# Base URL. Lokal/CI via Tunnel: fly proxy 4000:4000 -a tf-llm-gateway
GATEWAY_URL=http://localhost:4000

# Optional: logischer Alias (Default: news-curator/classify)
# GATEWAY_MODEL=news-curator/classify
